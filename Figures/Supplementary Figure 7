from pathlib import Path
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from matplotlib.ticker import MultipleLocator
from matplotlib.transforms import ScaledTranslation

script_dir = Path(__file__).resolve().parent
DATA_DIR = script_dir.parent / "Data" / "Supplementary Figure 7"
SAVE_DIR = script_dir / "Output" / "Supplementary Figure 7"
SAVE_DIR.mkdir(parents=True, exist_ok=True)

CSV_BASELINE = DATA_DIR / "Ca_transient_baseline_1Hz_3Hz_1Hz.csv"
CSV_LTCC_BLOCKER = DATA_DIR / "Ca_transient_LTCC_blocker_1Hz_3Hz_1Hz.csv"
CSV_NAK_PUMP_BLCOKER = DATA_DIR / "Ca_transient_NaK_pump_blocker_1Hz_3Hz_1Hz.csv"
CSV_HYPOTHETICAL_DRUG = DATA_DIR / "Ca_transient_hypothetical_drug_1Hz_3Hz_1Hz.csv"


WIDTH_CM = 19
HEIGHT_CM = 25.3
FIGSIZE = (WIDTH_CM / 2.54, HEIGHT_CM / 2.54)
DPI = 600
SHOW_FIGURE = True

PHASE_TIMES = (0, 24, 48, 72)
PHASE_LABELS = ("1 Hz", "3 Hz", "1 Hz")
PHASE_COLORS = ("#CCCCCC", "#999999", "#CCCCCC")

SERIES = (
    ("systolic_Ca", "Systolic Ca$^{2+}$", "#3D5C6F"),
    ("diastolic_Ca", "Diastolic Ca$^{2+}$", "#E47159"),
    ("CaT_amplitude", r"$\Delta[\mathrm{Ca}^{2+}]_i$", "#F9AE78"),
)

plt.rcParams.update({
    "font.family": "sans-serif",
    "font.sans-serif": ["Arial", "Helvetica", "DejaVu Sans"],
    "font.size": 9,
    "axes.labelweight": "bold",
    "pdf.fonttype": 42,
    "ps.fonttype": 42,
    "svg.fonttype": "none",
    "axes.linewidth": 0.9,
})

def load_ca_data(path: Path, suffix: str) -> pd.DataFrame:
    if not path.is_file():
        raise FileNotFoundError(f"CSV file not found: {path}")
    df = pd.read_csv(path)
    required = ["time_hr"] + [f"{key}_{suffix}" for key, _, _ in SERIES]
    missing = set(required) - set(df.columns)
    if missing:
        raise ValueError(f"Missing columns in {path.name}: {sorted(missing)}")
    df = df[required].apply(pd.to_numeric, errors="raise").sort_values("time_hr")
    if not np.isfinite(df.to_numpy()).all():
        raise ValueError(f"NaN/inf values in {path.name}")
    return df


def plot_block(ax, df: pd.DataFrame, suffix: str, heading: str, y_max: float):
    # Light grey backgrounds and pacing-frequency annotations.
    for i in range(3):
        ax.axvspan(PHASE_TIMES[i], PHASE_TIMES[i + 1],
                   facecolor=PHASE_COLORS[i], alpha=0.30, lw=0, zorder=0)
        ax.text(
            0.5 * (PHASE_TIMES[i] + PHASE_TIMES[i + 1]), 1.018,
            PHASE_LABELS[i], transform=ax.get_xaxis_transform(),
            ha="center", va="bottom", fontsize=9, fontweight="bold",
            clip_on=False,
        )

    for name, label, color in SERIES:
        ax.plot(df["time_hr"], df[f"{name}_{suffix}"],
                color=color, lw=1.5, ls="-", label=label, zorder=3)

    ax.set_title(heading, fontsize=10, fontweight="bold", pad=27, loc="center")
    ax.set_ylabel("Intracellular Ca$^{2+}$ (nM)",
                  fontsize=9, fontweight="bold", labelpad=8)
    ax.set_xlim(PHASE_TIMES[0], PHASE_TIMES[-1])
    ax.set_ylim(0, y_max)  
    ax.xaxis.set_major_locator(MultipleLocator(24))
    ax.xaxis.set_minor_locator(MultipleLocator(6))
    ax.yaxis.set_major_locator(MultipleLocator(200))
    ax.tick_params(axis="both", which="major", length=5, width=1, labelsize=8)
    # Make X and Y tick labels bold
    for label in ax.get_xticklabels() + ax.get_yticklabels():
        label.set_fontweight('bold')
        label.set_fontsize(10)
    ax.tick_params(axis="x", which="minor", length=3, width=0.75)
    for spine in ax.spines.values():
        spine.set_linewidth(0.9)


def main():
    df_baseline = load_ca_data(CSV_BASELINE, "baseline")
    df_LTCC_blocker = load_ca_data(CSV_LTCC_BLOCKER, "LTCC_blocker")
    df_NaK_pump_blocker = load_ca_data(CSV_NAK_PUMP_BLCOKER, "NaK_pump_blocker")
    df_hypothetical_drug = load_ca_data(CSV_HYPOTHETICAL_DRUG, "hypothetical_drug")

    max_value = max(
        float(df_baseline[[f"{key}_baseline" for key, _, _ in SERIES]].max().max()),
        float(df_LTCC_blocker[[f"{key}_LTCC_blocker" for key, _, _ in SERIES]].max().max()),
        float(df_NaK_pump_blocker[[f"{key}_NaK_pump_blocker" for key, _, _ in SERIES]].max().max()),
        float(df_hypothetical_drug[[f"{key}_hypothetical_drug" for key, _, _ in SERIES]].max().max()),
    )
    y_max = np.ceil(max_value * 1.07 / 50) * 50

    fig, (ax_a, ax_b, ax_c, ax_d) = plt.subplots(
        4, 1, figsize=FIGSIZE, sharex=True, facecolor="white"
    )
    plot_block(ax_a, df_baseline, "baseline", "Baseline", y_max)
    plot_block(ax_b, df_LTCC_blocker, "LTCC_blocker", "30% LTCC Blocker", y_max)
    plot_block(ax_c, df_NaK_pump_blocker, "NaK_pump_blocker", "30% Na$^+$/K$^+$ Pump Blocker", y_max)
    plot_block(ax_d, df_hypothetical_drug, "hypothetical_drug", "30% CaMKII Blocker", y_max)

    ax_a.tick_params(axis="x", which="both", labelbottom=True)
    ax_b.tick_params(axis="x", which="both", labelbottom=True)
    ax_c.tick_params(axis="x", which="both", labelbottom=True)
    ax_d.set_xlabel("Time (h)", fontsize=10, fontweight="bold", labelpad=7)

    handles, labels = ax_a.get_legend_handles_labels()
    fig.legend(handles, labels, loc="upper center", ncol=3,
               bbox_to_anchor=(0.57, 0.95), frameon=False,
               fontsize=9, handlelength=2.8, columnspacing=1.3, prop={'family': 'Arial', 'size': 9, 'weight': 'bold'})

    fig.subplots_adjust(left=0.14, right=0.95, top=0.855,
                        bottom=0.11, hspace=0.7)

    for ax, letter in ((ax_a, "A"), (ax_b, "B"), (ax_c, "C"), (ax_d, "D")):
        trans = ax.transAxes + ScaledTranslation(-42 / 72, 23 / 72, fig.dpi_scale_trans)
        ax.text(0, 1, letter, transform=trans,
                ha="left", va="bottom", fontsize=11, fontweight="bold")

    SAVE_DIR.mkdir(parents=True, exist_ok=True)
    base = SAVE_DIR / "Ca_transient_for_figure8_figure9_comparison"
    for extension in ("png", "pdf", "jpg"):
        target = base.with_suffix("." + extension)
        fig.savefig(target, dpi=DPI, facecolor="white")  
        print(f"Saved: {target}")
    if SHOW_FIGURE:
        plt.show()
    plt.close(fig)


if __name__ == "__main__":
    main()
