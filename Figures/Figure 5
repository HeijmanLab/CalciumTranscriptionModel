def create_figure(figsize=(17.6 / 2.54, 28 / 2.54)):
    fig = plt.figure(figsize=figsize)

    gs = gridspec.GridSpec(4, 2, figure=fig, hspace=0.5, wspace=0.4)

    gs_row0 = gs[0, :].subgridspec(1, 2, width_ratios=[3, 2], wspace=0.4)

    gs_A = gs_row0[0].subgridspec(1, 2, width_ratios=[5, 1], wspace=0.08)
    axA_left = fig.add_subplot(gs_A[0])
    axA_right = fig.add_subplot(gs_A[1])

    axB = fig.add_subplot(gs_row0[1])

    axC = fig.add_subplot(gs[1, 0])
    axD = fig.add_subplot(gs[1, 1])

    axE = fig.add_subplot(gs[2, 0])
    axF = fig.add_subplot(gs[2, 1])

    gs_G = gs[3, :].subgridspec(1, 2, width_ratios=[0.15, 0.85], wspace=0.08)
    axG_left = fig.add_subplot(gs_G[0])
    axG_right = fig.add_subplot(gs_G[1])

    axes = {
        'A_left': axA_left,
        'A_right': axA_right,
        (0, 1): axB,    
        (1, 0): axC,    
        (1, 1): axD,  
        (2, 0): axE,   
        (2, 1): axF,    
        'G_left': axG_left,
        'G_right': axG_right,
    }
    return fig, axes

    

def finalize_figure(fig, path):

    fig.savefig(path, dpi=1000, format='jpg', bbox_inches='tight')
    plt.show()

from pathlib import Path

def main():
    fig, axes = create_figure()

    plot_A(axes['A_left'], axes['A_right'], fig)
    plot_B(axes[(0, 1)])
    plot_C(axes[(1, 0)])
    plot_D(axes[(1, 1)])
    plot_E(axes[(2, 0)])
    plot_F(axes[(2, 1)])
    plot_G(axes['G_left'], axes['G_right'], fig)

    script_dir = Path(__file__).resolve().parent
    output_dir = script_dir / "Output"
    output_dir.mkdir(parents=True, exist_ok=True)
    output_path = output_dir / "figure 5.jpg"

    finalize_figure(fig, output_path)

if __name__ == "__main__":
    main()
