def plot_A(ax_left, ax_right, fig):
    def transform_time_left(x):
        return np.where(x <= 1, x * 0.2, 0.2 + (x - 1) * 2 / 3)

    df_sec = pd.read_csv(data_dir / "CaMKII_1Hz_0_1min.csv")
    df_min = pd.read_csv(data_dir / "CaMKII_3Hz_1_60min.csv")

    x_1hz = df_sec['t_min_1Hz']
    y_1hz = df_sec['relative value_1Hz']

    df_3hz_early = df_min[df_min['t_min_3Hz'] <= 2.2]
    x_3hz_early = df_3hz_early['t_min_3Hz']
    y_3hz_early = df_3hz_early['relative value_3Hz']

    df_3hz_late = df_min[df_min['t_min_3Hz'] >= 58.5]
    x_3hz_late = df_3hz_late['t_min_3Hz']
    y_3hz_late = df_3hz_late['relative value_3Hz']

    y_all = pd.concat([y_1hz, y_3hz_early, y_3hz_late])
    y_top = max(y_all) * 1.15
    y_lim = (0, y_top)

    x_1hz_plot = transform_time_left(x_1hz)
    x_3hz_early_plot = transform_time_left(x_3hz_early)

    ax_left.plot(x_1hz_plot, y_1hz, linewidth=1.5, color='#508ab2', label='1 Hz')
    ax_left.plot(x_3hz_early_plot, y_3hz_early, linewidth=1.5, color='#508ab2', label='3 Hz')

    ax_left.axvspan(0, 0.2, color='lightgray', alpha=0.3)   
    ax_left.axvspan(0.2, 1.0, color='lightblue', alpha=0.2) 

    ax_left.set_xlim(0, 1.0)
    ax_left.set_ylim(y_lim)

    ax_left.set_xticks([0.0, 0.2, 0.2 + (1/6)*0.8, 0.2 + (2/6)*0.8, 0.2 + (3/6)*0.8, 0.2 + (4/6)*0.8, 0.2 + (5/6)*0.8])  
    ax_left.set_xticklabels(['0', '1', '1.2', '1.4', '1.6', '1.8', '2'])

    ax_left.set_xlabel("Time (min)")
    ax_left.xaxis.set_label_coords(0.65, -0.2)
    ax_left.set_ylabel("Relative CaMKII Activity\n(% of 1 Hz at time = 0)")
    ax_left.tick_params(width=1.2)
    ax_left.text(-0.3, 1.15, "A", transform=ax_left.transAxes, fontweight='bold', va='top', ha='left')

    ax_left.text(0.1, 1.02, "1 Hz", transform=ax_left.transAxes, ha='center', va='bottom', fontsize=10)
    ax_left.text(0.7, 1.02, "3 Hz", transform=ax_left.transAxes, ha='center', va='bottom', fontsize=10)

    ax_left.spines['right'].set_visible(False)

    ax_right.plot(x_3hz_late, y_3hz_late, linewidth=1.5, color='#508ab2')
    ax_right.axvspan(58.5, 60, color='lightblue', alpha=0.2)

    ax_right.set_xlim(58.5, 60)
    ax_right.set_ylim(y_lim)
    ax_right.set_xticks([59, 60])
    ax_right.set_xticklabels(['59', '60'])

    ax_right.tick_params(width=1.2)
    ax_right.tick_params(labelleft=False)
    ax_right.spines['left'].set_visible(False)
    ax_right.tick_params(axis='y', left=False, labelleft=False)

