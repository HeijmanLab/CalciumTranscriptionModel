import pandas as pd
import matplotlib.pyplot as plt
from matplotlib import rcParams
from matplotlib.ticker import MultipleLocator

rcParams['font.family'] = 'Arial'
rcParams['font.size'] = 9
rcParams['font.weight'] = 'bold'

from pathlib import Path
script_dir = Path(__file__).resolve().parent
data_dir = script_dir.parent / "Data" / "Figure 9"
df_a = pd.read_csv(data_dir / "ICaL_peak_combine_1Hz_3Hz_1Hz.csv")
df_b = pd.read_csv(data_dir / "CaT_amplitude_1Hz_3Hz_1Hz.csv")
df_c = pd.read_csv(data_dir / "APD90_combine_1Hz_3Hz_1Hz.csv")

phase_times = [0, 24, 48, 72]
phase_labels = ['1 Hz', '3 Hz', '1 Hz']
phase_colors = ['#cccccc', '#999999', '#cccccc']

width_cm = 17.6
height_cm = 21  
figsize = (width_cm / 2.54, height_cm / 2.54)

fig, axes = plt.subplots(3, 1, figsize=figsize)

ymax_ic = df_a[['I_CaL_entry_integral_baseline', 'I_CaL_entry_integral_hypothetical_drug']].max().max()
ymin_ic = df_a[['I_CaL_entry_integral_baseline', 'I_CaL_entry_integral_hypothetical_drug']].min().min()
y_margin_ic = (ymax_ic - ymin_ic) * 0.1
ymax_ic += y_margin_ic
ymin_ic -= y_margin_ic

ymax_apd = df_c[['apd90_baseline', 'apd90_hypothetical_drug']].max().max()
ymin_apd = df_c[['apd90_baseline', 'apd90_hypothetical_drug']].min().min()
y_margin_apd = (ymax_apd - ymin_apd) * 0.1
ymax_apd += y_margin_apd
ymin_apd -= y_margin_apd

def plot_block(ax, x, y_list, labels, colors, ylabel=None, ylim=None):
    for i in range(3):
        ax.axvspan(phase_times[i], phase_times[i+1], color=phase_colors[i], alpha=0.4)
        ax.text((phase_times[i]+phase_times[i+1])/2, 1.005, phase_labels[i],
                transform=ax.get_xaxis_transform(), ha='center', va='bottom', weight='bold', fontsize=10)
    for y, label, color in zip(y_list, labels, colors):
        ax.plot(x, y, color=color, label=label, linewidth=1.5)
    if ylabel:
        ax.set_ylabel(ylabel, fontweight='bold')
    if ylim:
        ax.set_ylim(ylim)
    ax.set_xlim(0, 72)
    ax.xaxis.set_major_locator(MultipleLocator(12))
    ax.xaxis.set_minor_locator(MultipleLocator(6))
    ax.tick_params(axis='both', which='major', length=6, width=1.2)
    ax.tick_params(axis='both', which='minor', length=3, width=0.8)
    for spine in ax.spines.values():
        spine.set_linewidth(1)

plot_block(
    axes[0],
    df_a['time_hr'],
    [df_a['I_CaL_entry_integral_baseline'], df_a['I_CaL_entry_integral_hypothetical_drug']],
    ['baseline with\ntranscription', '30% MEF2-miR-1\npathway blocker'],
    ['#a17db4', '#7c9895'],
    r"I$_{Ca,L}$ Entry Integral (pA·ms/pF)",
    (ymin_ic, ymax_ic)
)

plot_block(
    axes[1],
    df_b['time_hr'],
    [df_b['Calcium_transient_amplitude_baseline'], df_b['Calcium_transient_amplitude_hypothetical_drug']],
    ['baseline with\ntranscription', '30% MEF2-miR-1\npathway blocker'],
    ['#a17db4', '#7c9895'],  
    r"$\mathrm{\Delta[Ca^{2+}]_i}$ (nM)",
    (0, None)
)


plot_block(
    axes[2],
    df_c['time_hr'],
    [df_c['apd90_baseline'], df_c['apd90_hypothetical_drug']],
    ['baseline with\ntranscription', '30% MEF2-miR-1\npathway blocker'],
    ['#a17db4', '#7c9895'],
    r"$\mathrm{APD}_{90}$ (ms)",
    (ymin_apd, ymax_apd)
)
axes[2].set_xlabel(
    "Time (h)",
    fontsize=10,
    fontweight="bold",
    labelpad=8
)

lines_a = [
    plt.Line2D([0], [0], color='#a17db4', lw=1.5, label='Baseline'),
    plt.Line2D([0], [0], color='#7c9895', lw=1.5, label='30% CaMK$_{0}$\nblocker'),
]
fig.legend(handles=lines_a, loc='center left', bbox_to_anchor=(0.80, 0.5), frameon=False, fontsize=9)


fig.text(0.05, 0.95, "A", fontsize=10, fontweight='bold', ha='left', va='top')
fig.text(0.05, 0.63, "B", fontsize=10, fontweight='bold', ha='left', va='top')
fig.text(0.05, 0.33, "C", fontsize=10, fontweight='bold', ha='left', va='top')


from pathlib import Path

# Get the directory containing this Python script
script_dir = Path(__file__).resolve().parent

# Create the output folder if it does not exist
output_dir = script_dir / "Output"
output_dir.mkdir(parents=True, exist_ok=True)

# Adjust figure layout
fig.subplots_adjust(
    left=0.15,
    right=0.8,
    top=0.92,
    bottom=0.08,
    hspace=0.4,
    wspace=0.33
)

# Save Figure 9
save_path = output_dir / "Figure 9.jpg"

plt.savefig(
    save_path,
    dpi=600,
    format='jpg'
)

plt.show()

