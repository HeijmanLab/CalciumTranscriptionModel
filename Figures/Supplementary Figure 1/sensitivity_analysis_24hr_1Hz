# ============================================================

# Startup checks

# ============================================================

for csv_name, myokit_name in parameter_map.items():

    if csv_name not in population_table.columns:

        raise ValueError(

            f"Missing CSV parameter: {csv_name}"

        )

    try:

        m.get(myokit_name)

    except KeyError:

        raise ValueError(

            f"Myokit variable not found: {myokit_name}"

        )

try:

    m.get(CALCIUM_VAR)

except KeyError:

    raise ValueError(

        f"Calcium variable not found: {CALCIUM_VAR}"

    )

try:

    m.get(ACTIVE_LTCC_VAR)

except KeyError:

    raise ValueError(

        f"Active-LTCC variable not found: {ACTIVE_LTCC_VAR}"

    )

# Prefer Myokit's standard membrane-potential label.

v_var = m.label('membrane_potential')

if v_var is not None:

    VOLTAGE_VAR = v_var.qname()

else:

