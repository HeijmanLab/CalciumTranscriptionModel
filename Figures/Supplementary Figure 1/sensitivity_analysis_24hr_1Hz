# First use:
#     TEST_MODE = True
# This runs only run_001 with SPEEDUP = 100 and writes files with
# a quick_test_ prefix. These files are NOT used by the formal run.
#
# After the workflow test succeeds, change ONLY this line to:
#     TEST_MODE = False
# The script will then use SPEEDUP = 1 and run the full 100-cell
# population, with automatic resume from completed formal runs.

TEST_MODE = False

TEST_RUNS = 100

TEST_SPEEDUP = 100

if TEST_MODE:

    SPEEDUP = TEST_SPEEDUP

    RUN_LIMIT = TEST_RUNS

    SUMMARY_FILE = 'quick_test_sensitivity_outputs.csv'

    FILE_PREFIX = 'quick_test_'

else:

    SPEEDUP = 1

    RUN_LIMIT = None

    SUMMARY_FILE = 'sensitivity_outputs.csv'

    FILE_PREFIX = ''

CONVERSION_FACTOR = 1 / 3600000

# Dense logging interval used for the recorded beat/window

LOG_INTERVAL = 0.1

# Existing adaptive-sampling design

BEATS_TO_LOG = 5

SENS_FREQ = 1

SENS_HOURS = 24

PREPACE_FREQ = 0.5

PREPACE_BCL = 2000

PREPACE_HOURS = 12

CALCIUM_VAR = 'Ca_Concentrations.Ca_inano'

ACTIVE_LTCC_VAR = 'transcription.Act'


# ============================================================

# Load model

# ============================================================

