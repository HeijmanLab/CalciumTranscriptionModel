# ============================================================

# Load population parameter table

# ============================================================

population_table = pd.read_csv(

    POPULATION_FILE,

    index_col=0

)

print("\nPopulation table loaded successfully.")

print("Number of available runs:", len(population_table))

print("Number of sampled parameters:", len(population_table.columns))


# ============================================================

# Map CSV names to Myokit variable names

# ============================================================

parameter_map = {

    # CaMKII

    'CaMK0': 'parameters.CaMK0',

    'Km_CaM': 'parameters.Km_CaM',

    'alpha_CaMK': 'parameters.alpha_CaMK',

