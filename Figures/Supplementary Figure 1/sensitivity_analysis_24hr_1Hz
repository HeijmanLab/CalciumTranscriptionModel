# ============================================================

# Apply baseline + population-specific constants

# ============================================================

def apply_population_constants(

    sim,

    population_row,

    ref_ICaL_Act=None

):

    """

    Apply baseline constants first, then override the selected

    24 parameters using one row of the population table.

    If ref_ICaL_Act is supplied, it is also applied. This allows

    each virtual cell to use the reference Active-LTCC value

    obtained after its own 0.5-Hz pre-pacing.

    """

    # Baseline constants

    for k, v in baseline_constants.items():

        sim.set_constant(

            k,

            v

        )

    # The sampled 24 parameters override baseline values

    for (

        csv_name,

        myokit_name

    ) in parameter_map.items():

        value = float(

            population_row[

                csv_name

            ]

        )

        sim.set_constant(

            myokit_name,

            value

        )

    # Run-specific reference after pre-pacing

    if ref_ICaL_Act is not None:

        sim.set_constant(

            'I_Ca.ref_transcription_Act',

            float(ref_ICaL_Act)

        )


# ============================================================

# Pre-pace ONE population member at 0.5 Hz

# ============================================================

def prepace_population_member(

    run_name,

    population_row

):

    """

    Each virtual cell is pre-paced separately.

    The same sampled 24-parameter set is therefore present during:

        12 h at 0.5 Hz pre-pacing

        24 h at 1 Hz adaptation

        final recorded 1-Hz beat

    Returns:

        pre_state:

            final state after this cell's own pre-pacing

        ref_ICaL_Act:

            this cell's Active-LTCC reference measured after

            its own pre-pacing

    """

    print(

        f"\nPre-pacing {run_name} at "

        f"{PREPACE_FREQ} Hz for "

        f"{PREPACE_HOURS} biological h"

    )

    p_pre = make_protocol(

        PREPACE_FREQ

    )

    s_pre = myokit.Simulation(

        m,

        p_pre

    )

    s_pre.set_tolerance(

        1E-8

    )

    # IMPORTANT:

    # Apply this virtual cell's sampled parameters BEFORE pre-pacing.

    apply_population_constants(

        sim=s_pre,

        population_row=population_row,

        ref_ICaL_Act=None

    )

    prepace_duration = (

        PREPACE_HOURS

        * 3600000

        / SPEEDUP

    )

    print(

        f"Pre-pacing model duration "

        f"= {prepace_duration} ms"

    )

    s_pre.pre(

        prepace_duration

    )

    # Save this virtual cell's own pre-paced state

    pre_state = list(

        s_pre.state()

    )

    # Measure this virtual cell's own reference Active LTCC

    # immediately after pre-pacing.

    d_ref = run_local(

        s_pre,

        duration=PREPACE_BCL,

        log=[ACTIVE_LTCC_VAR],

        dt=1

    )

    ref_ICaL_Act = float(

        d_ref[

            ACTIVE_LTCC_VAR

        ][-1]

    )

    print(

        f"{run_name} reference ICaL_Act "

        f"at 0.5 Hz = {ref_ICaL_Act}"

    )

    return (

        pre_state,

        ref_ICaL_Act

    )


# ============================================================

# Create one population-member simulation at the target rate

# ============================================================

def make_sim(

    freq,

    state,

    population_row,

    ref_ICaL_Act

):

    """

    Create the target-frequency simulation for one virtual cell.

    The same sampled parameter set used during pre-pacing is

    applied again here, together with that cell's own reference

    Active-LTCC value.

    """

    sim = myokit.Simulation(

        m,

        make_protocol(freq)

    )

    sim.set_tolerance(

        1E-8

    )

    apply_population_constants(

        sim=sim,

        population_row=population_row,

        ref_ICaL_Act=ref_ICaL_Act

    )

    sim.set_state(

        state

    )

    return sim


# ============================================================

# Existing adaptive sampling design for the 24-h 1-Hz phase

# ============================================================

def get_segments_for_phase(hours):

    """

    Preserve the original phase-1 sampling design:

        first 1 h:

            sample every 5 s

        remaining time:

            sample every 10 min

    Each sampling window logs BEATS_TO_LOG complete beats.

    """

    return [

        (

            'first_1h_dense',

            min(hours, 1),

            5

        ),

        (

            'remaining_sparse',

            max(hours - 1, 0),

            600

        )

    ]


def run_phase(

    sim,

    freq,

    hours,

    phase_name

):

    """

    Run the 24-h 1-Hz phase with the existing adaptive sampling.

    Only Ca-transient summary values are retained from each

    sampling window, so the 24-h phase does not create a huge file.

    """

    bcl = 1000 / freq

    segments = get_segments_for_phase(

        hours

    )

    rows = []

    sample_index = 0

    phase_elapsed_beats = 0

    print(

        f"\nStarting {phase_name}"

    )

    print(

        f"BCL = {bcl} ms"

    )

    for (

        segment_name,

        segment_hours,

        sample_every_sec

    ) in segments:

        if segment_hours <= 0:

            continue

        segment_ms = (

            segment_hours

            * 3600000

            / SPEEDUP

        )

        segment_beats = int(

            round(

                segment_ms / bcl

            )

        )

        interval_ms = (

            sample_every_sec

            * 1000

            / SPEEDUP

        )

        interval_beats = int(

            round(

                interval_ms / bcl

            )

        )

        interval_beats = max(

            BEATS_TO_LOG,

            interval_beats

        )

        beats_done = 0

        print(

            f"  Segment: {segment_name}"

        )

        print(

            f"  Segment hours: "

            f"{segment_hours:.6f}"

        )

        print(

            f"  Segment beats: "

            f"{segment_beats}"

        )

        print(

            f"  Sample interval beats: "

            f"{interval_beats}"

        )

        while (

            beats_done

            + interval_beats

            <= segment_beats

        ):

            quiet_beats = (

                interval_beats

                - BEATS_TO_LOG

            )

            # State evolves without saving raw trace.

            if quiet_beats > 0:

                run_local(

                    sim,

                    duration=(

                        quiet_beats

                        * bcl

                    ),

                    log=[]

                )

            # Record only the small sampling window.

            d = run_local(

                sim,

                duration=(

                    BEATS_TO_LOG

                    * bcl

                ),

                log=[

                    'engine.time',

                    CALCIUM_VAR

                ],

                dt=LOG_INTERVAL

            )

            if d is not None:

                t_local = np.asarray(

                    d['engine.time']

                )

                ca_local = np.asarray(

                    d[CALCIUM_VAR]

                )

                df = (

                    extract_ca_transient_amplitude(

                        t=t_local,

                        ca=ca_local,

                        bcl=bcl

                    )

                )

                if len(df) > 0:

                    sample_index += 1

                    window_start_beats = (

                        phase_elapsed_beats

                        + beats_done

                        + quiet_beats

                    )

                    window_start_ms = (

                        window_start_beats

                        * bcl

                    )

                    df[

                        'phase_time_model_ms'

                    ] = (

                        window_start_ms

                        + df['time']

                    )

                    df[

                        'phase_time_biological_h'

                    ] = (

                        df[

                            'phase_time_model_ms'

                        ]

                        * SPEEDUP

                        / 3600000

                    )

                    df['phase'] = (

                        phase_name

                    )

                    df['freq_Hz'] = (

                        freq

                    )

                    df['sample_index'] = (

                        sample_index

                    )

                    df['segment'] = (

                        segment_name

                    )

                    rows.append(

                        df

                    )

            beats_done += (

                interval_beats

            )

        # Complete any unsampled remainder silently.

        leftover_beats = (

            segment_beats

            - beats_done

        )

        if leftover_beats > 0:

            run_local(

                sim,

                duration=(

                    leftover_beats

                    * bcl

                ),

                log=[]

            )

        phase_elapsed_beats += (

            segment_beats

        )

        print(

            f"  {phase_name} "

            f"{segment_name} done: "

            f"{phase_elapsed_beats * bcl * SPEEDUP / 3600000:.4f} "

            f"biological h"

        )

    if len(rows) == 0:

        return pd.DataFrame()

    return pd.concat(

        rows,

        ignore_index=True

    )


# ============================================================

# Record one complete final 1-Hz beat

# ============================================================

def record_final_beat(

    sim,

    freq,

    run_name

):

    """

    Continue directly from the final state of the 24-h phase and

    densely record one additional complete beat.

    This trace is used for:

        AP morphology

        Ca transient morphology

        CaT amplitude

        APD90

        final Active LTCC

    """

    bcl = 1000 / freq

    d = run_local(

        sim,

        duration=bcl,

        log=[

            'engine.time',

            VOLTAGE_VAR,

            CALCIUM_VAR,

            ACTIVE_LTCC_VAR

        ],

        dt=LOG_INTERVAL

    )

    if d is None:

        raise RuntimeError(

            f"No final-beat data returned for {run_name}."

        )

    t = np.asarray(

        d['engine.time']

    )

    v = np.asarray(

        d[VOLTAGE_VAR]

    )

    ca = np.asarray(

        d[CALCIUM_VAR]

    )

    active_ltcc_trace = np.asarray(

        d[ACTIVE_LTCC_VAR]

    )

    if len(t) < 3:

        raise RuntimeError(

            f"Final-beat recording for {run_name} "

            f"contains too few samples."

        )

    ca_tamp = float(

        np.max(ca)

        - np.min(ca)

    )

    apd90 = calculate_apd90(

        t,

        v

    )

    active_ltcc = float(

        active_ltcc_trace[-1]

    )

    df_final = pd.DataFrame({

        'run': run_name,

        'time_ms': t,

        'Vm': v,

        'Ca': ca,

        'Active_LTCC': active_ltcc_trace

    })

    return (

        active_ltcc,

        ca_tamp,

        apd90,

        df_final

    )


# ============================================================

# Run one virtual cell

# ============================================================

def run_sensitivity_member(

    run_name,

    population_row,

    hours=SENS_HOURS,

    freq=SENS_FREQ

):

    """

    One population member:

        apply sampled parameter set

        -> 12 h at 0.5 Hz pre-pacing

        -> obtain run-specific pre_state and Active-LTCC reference

        -> 24 h at 1 Hz with SAME sampled parameter set

        -> record one final complete beat

    """

    print("\n" + "=" * 70)

    print(f"Starting {run_name}")

    print("=" * 70)

    # --------------------------------------------------------

    # 1. Population-specific 0.5-Hz pre-pacing

    # --------------------------------------------------------

    (

        pre_state,

        ref_ICaL_Act

    ) = prepace_population_member(

        run_name=run_name,

        population_row=population_row

    )

    # --------------------------------------------------------

    # 2. Continue this SAME virtual cell at 1 Hz

    # --------------------------------------------------------

    sim = make_sim(

        freq=freq,

        state=pre_state,

        population_row=population_row,

        ref_ICaL_Act=ref_ICaL_Act

    )

    # --------------------------------------------------------

    # 3. 24-h 1-Hz adaptation with adaptive sampling

    # --------------------------------------------------------

    df_adaptive = run_phase(

        sim=sim,

        freq=freq,

        hours=hours,

        phase_name=(

            f'sensitivity_{run_name}'

        )

    )

    # --------------------------------------------------------

    # 4. Record one complete final beat

    # --------------------------------------------------------

    (

        active_ltcc,

        ca_tamp,

        apd90,

        df_final

    ) = record_final_beat(

        sim=sim,

        freq=freq,

        run_name=run_name

    )

    summary = {

        'run': run_name,

        'prepace_ref_Active_LTCC': ref_ICaL_Act,

        'Active_LTCC': active_ltcc,

        'CaTamp': ca_tamp,

        'APD90_ms': apd90

    }

    print(f"\n{run_name} completed")
    print(f"Prepace ref Active LTCC = {ref_ICaL_Act}")
    print(f"Final Active LTCC       = {active_ltcc}")
    print(f"CaTamp                  = {ca_tamp}")

    print(f"APD90                   = {apd90} ms")

    return (summary, df_adaptive, df_final)


if TEST_MODE:

    # --------------------------------------------------------
    # Quick workflow test
    #
    # Always starts fresh and uses separate quick_test_ files.
    # It never changes or reads the formal 100-run summary.
    # --------------------------------------------------------

    runs_to_execute = (

        population_table.iloc[

            :RUN_LIMIT

        ]

    )

    summary_rows = []

    completed_runs = set()

else:

    # --------------------------------------------------------
    # Formal 100-run mode with automatic resume.
    #
    # If sensitivity_outputs.csv already exists, completed runs
    # are skipped and the script continues with the remaining
    # population members.
    # --------------------------------------------------------

    try:

        existing_summary = pd.read_csv(

            SUMMARY_FILE

        )

        if 'run' not in existing_summary.columns:

            raise ValueError(

                f"{SUMMARY_FILE} does not contain a 'run' column."

            )

        # Keep only run IDs that belong to the current population.
        existing_summary = existing_summary[

            existing_summary['run'].isin(

                population_table.index

            )

        ].copy()

        # Protect against duplicated rows after a previous restart.
        existing_summary = (

            existing_summary

            .drop_duplicates(

                subset='run',

                keep='last'

            )

            .sort_values('run')

            .reset_index(drop=True)

        )

        completed_runs = set(

            existing_summary['run']

        )

        summary_rows = (

            existing_summary

            .to_dict('records')

        )

        print(

            f"\nResume file found: {SUMMARY_FILE}"

        )

        print(

            f"Completed formal runs: {len(completed_runs)}"

        )

    except FileNotFoundError:

        completed_runs = set()

        summary_rows = []

        print(

            "\nNo formal summary file found. "

            "Starting a fresh 100-run simulation."

        )

    runs_to_execute = population_table.loc[

        ~population_table.index.isin(

            completed_runs

        )

    ]


