            "'membrane.V' was not found."

        )

print("Population parameter mapping check passed.")

print("Voltage variable:", VOLTAGE_VAR)


# ============================================================

# Helper functions

# ============================================================

def run_local(sim, duration, log=None, dt=None):

    """

    Run one simulation chunk with local time reset.

    sim.set_time(0) resets the simulation clock but not the

    model state. This preserves the existing chunked-run logic.

    """

    duration = float(duration)

    if duration <= 1e-9:

        return None

    sim.set_time(0)

    if not log:

        return sim.run(duration, log=[])

    if dt is None:

        return sim.run(duration, log=log)

    # Avoid logging exactly at t=0 or exactly at final time.

    log_times = np.arange(

        dt,

        duration - 0.5 * dt,

        dt

    )

    if len(log_times) < 3:

        return sim.run(duration, log=[])

    return sim.run(

        duration,

        log=log,

        log_times=log_times

    )


def make_protocol(freq):

    bcl = 1000 / freq

    protocol = myokit.Protocol()

    protocol.schedule(

        1,

        0,

        5,

        bcl,

        0

    )

    return protocol


def extract_ca_transient_amplitude(t, ca, bcl):

    """

    Extract systolic Ca, diastolic Ca, and Ca transient amplitude

    from a local calcium trace.

    """

    t = np.asarray(t)

    ca = np.asarray(ca)

    ca_peak_times = []

    systolic_values = []

    diastolic_values = []

    amplitude_values = []

    if len(t) < 3:

        return pd.DataFrame({

            'time': [],

            'systolic_Ca': [],

            'diastolic_Ca': [],

            'CaT_amplitude': []

        })

    beat_starts = np.arange(

        0,

        t[-1],

        bcl

    )

    for beat_start in beat_starts:

        beat_end = beat_start + bcl

        idx = np.where(

            (t >= beat_start)

            & (t < beat_end)

        )[0]

        if len(idx) < 3:

            continue

        tt = t[idx]

        cc = ca[idx]

        peak_idx = np.argmax(cc)

        ca_sys = np.max(cc)

        ca_dia = np.min(cc)

        ca_amp = ca_sys - ca_dia

        ca_peak_times.append(

            tt[peak_idx]

        )

        systolic_values.append(

            ca_sys

        )

        diastolic_values.append(

            ca_dia

        )

        amplitude_values.append(

            ca_amp

        )

    return pd.DataFrame({

        'time': ca_peak_times,

        'systolic_Ca': systolic_values,

        'diastolic_Ca': diastolic_values,

        'CaT_amplitude': amplitude_values

    })


def calculate_apd90(t, v):

    """

    Calculate APD90 from one complete recorded beat.

    APD90 is measured from the maximum-dV/dt upstroke time

    to the downward crossing of the 90%-repolarization level.

    """

    t = np.asarray(t)

    v = np.asarray(v)

    if len(t) < 10:

        return np.nan

    peak_idx = int(np.argmax(v))

    if peak_idx < 2:

        return np.nan

    v_peak = float(v[peak_idx])

    v_rest = float(np.min(v))

    # 90% repolarization = 10% of AP amplitude above resting V.

    v90 = v_rest + 0.1 * (

        v_peak - v_rest

    )

    dvdt = np.gradient(

        v,

        t

    )

    upstroke_idx = int(

        np.argmax(

            dvdt[:peak_idx + 1]

        )

    )

    t_activation = float(

        t[upstroke_idx]

    )

    # Find the downward V90 crossing after the AP peak.

    for i in range(

        peak_idx,

        len(v) - 1

    ):

        if (

            v[i] >= v90

            and v[i + 1] < v90

        ):

            fraction = (

                (v90 - v[i])

                / (v[i + 1] - v[i])

            )

            t_repol = (

                t[i]

                + fraction

                * (t[i + 1] - t[i])

            )

            return float(

                t_repol - t_activation

            )

    return np.nan


