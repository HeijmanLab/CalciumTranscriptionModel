import pandas as pd
import matplotlib.pyplot as plt
from matplotlib import rcParams
from matplotlib.lines import Line2D
import matplotlib.patches as mpatches
import numpy as np
from matplotlib import gridspec
from pathlib import Path

rcParams['font.family'] = 'Arial'
rcParams['font.size'] = 10
rcParams['font.weight'] = 'bold'

figsize = (26 / 2.54, 14 / 2.54)  

from pathlib import Path

script_dir = Path(__file__).resolve().parent

data_dir = script_dir.parent / "Data" / "Figure 4"

file_path_mRNA = data_dir / "Dynamic Decay in Cav12 mRNA Levels.csv"
file_path_protein = data_dir / "Dynamic Decay in Cav12 Protein Levels.csv"

mRNA_df = pd.read_csv(file_path_mRNA)
protein_df = pd.read_csv(file_path_protein)

time_mRNA = mRNA_df['Time']
sim_mRNA = mRNA_df['Simulation percentage']
exp_col_mRNA = 'Rosati et al. (2011) percentage'
exp_mRNA = mRNA_df[exp_col_mRNA].dropna()
exp_time_mRNA = mRNA_df.loc[mRNA_df[exp_col_mRNA].notna(), 'Time']

time_protein = protein_df['Time']
sim_protein = protein_df['Simulation percentage']
exp_col_protein = 'Catalucci et al. (2009) percentage'
exp_protein = protein_df[exp_col_protein].dropna()
exp_time_protein = protein_df.loc[protein_df[exp_col_protein].notna(), 'Time']

groups_C = ['0', '10']
exp_data_C = [100.000, 50]
sim_data_C = [100.000, 46.759]

sim_color = '#A0BDD5'
exp_color_mRNA = '#CA8BA8'
exp_color_protein = '#8583A9'
exp_color_bar = '#A5CCC7'
SIM_EDGE  = '#4D4D4D'
SIM_HATCH = '///'

def style_axes(ax):
    ax.tick_params(width=1.2, labelsize=10)
    for s in ax.spines.values():
        s.set_linewidth(1.2)


def add_panel_left_of_ylabel(fig, ax, letter, xpad_pts=6, ypad_pts=0, fontsize=11):
    """
    将 panel label 放在该轴 y-label 的左上角外侧：
    - 以 y-label 的 bbox 为基准（避免 A/C 重叠、B 偏离）
    - xpad/ypad 用 pt 控制，跨 panel 稳定一致
    """
    fig.canvas.draw()
    renderer = fig.canvas.get_renderer()

    ylb = ax.yaxis.label.get_window_extent(renderer=renderer)  # y-label bbox (display coords)
    inv = fig.transFigure.inverted()
    x0, y1 = inv.transform((ylb.x0, ylb.y1))  # to figure coords

    xpad = xpad_pts / 72 / fig.get_size_inches()[0]
    ypad = ypad_pts / 72 / fig.get_size_inches()[1]

    fig.text(
        x0 - xpad, y1 + ypad, letter,
        ha='right', va='bottom',
        fontweight='bold', fontsize=fontsize
    )

fig = plt.figure(figsize=figsize)
gs = gridspec.GridSpec(2, 2, wspace=0.3, hspace=0.35)

axA = fig.add_subplot(gs[0, 0])
axB = fig.add_subplot(gs[0, 1])
axC = fig.add_subplot(gs[1, 0])
axD = fig.add_subplot(gs[1, 1]) 
axD.axis('off')

fig.subplots_adjust(left=0.10, right=0.95, top=0.95, bottom=0.12)

axA.plot(time_mRNA, sim_mRNA, color=sim_color, linewidth=2)
axA.scatter(exp_time_mRNA, exp_mRNA, color=exp_color_mRNA, zorder=5, s=30, edgecolor='none')
axA.set_xlabel("Time (h)", fontweight='bold', fontsize=12)
axA.set_ylabel("Relative Ca$_{V}$1.2 mRNA Levels\n(% of 0 h)", fontweight='bold', fontsize=12)
axA.set_ylim(0, 110)
axA.grid(False)
style_axes(axA)

axB.plot(time_protein, sim_protein, color=sim_color, linewidth=2)
axB.scatter(exp_time_protein, exp_protein, color=exp_color_protein, zorder=5, s=30, edgecolor='none')
axB.set_xlabel("Time (h)", fontweight='bold', fontsize=12)
axB.set_ylabel("Relative Ca$_{V}$1.2 Protein Levels\n(% of 0 h)", fontweight='bold', fontsize=12)
axB.set_ylim(0, 110)
axB.grid(False)
style_axes(axB)
err_exp_B = [0, 3.404, 3.830, 1.702]

axB.scatter(exp_time_protein, exp_protein, color=exp_color_protein, s=30, zorder=5, edgecolor='none')

axB.errorbar( exp_time_protein, exp_protein, yerr=[np.zeros_like(err_exp_B), err_exp_B], fmt='none', ecolor='black',
    capsize=3, lw=1, capthick=1)


x_C = np.arange(len(groups_C))
bar_width = 0.35
axC.bar(x_C - bar_width/2, exp_data_C, width=bar_width, color=exp_color_bar, edgecolor='black')
axC.bar(x_C + bar_width/2, sim_data_C, width=bar_width,
        facecolor='none', edgecolor=SIM_EDGE, hatch=SIM_HATCH, linewidth=1)

axC.set_xticks(x_C)
axC.set_xticklabels(groups_C)
axC.set_ylabel("Relative Ca$_{V}$β2 Protein Levels\n(% of 0 h)", fontweight='bold', fontsize=12)
axC.set_xlabel("Time (h)", fontweight='bold', fontsize=12)
axC.grid(False)
style_axes(axC)

fig.align_ylabels([axA, axB, axC])
for ax in [axA, axB, axC]:
    ax.yaxis.labelpad = 8

add_panel_left_of_ylabel(fig, axA, "A", xpad_pts=6, ypad_pts=0, fontsize=12)
add_panel_left_of_ylabel(fig, axB, "B", xpad_pts=6, ypad_pts=0, fontsize=12)
add_panel_left_of_ylabel(fig, axC, "C", xpad_pts=6, ypad_pts=0, fontsize=12)

legend_elements = [
    Line2D([0], [0], color=exp_color_mRNA, marker='o', linestyle='None', markersize=6, label='Rosati et al. (2011)'),
    Line2D([0], [0], color=exp_color_protein, marker='o', linestyle='None', markersize=6, label='Catalucci et al. (2009)'),
    mpatches.Patch(color=exp_color_bar, label='Meissner et al. (2011)'),
    Line2D([0], [0], color=sim_color, linestyle='-', linewidth=2, label='Simulation (panel A + panel B)'),
    mpatches.Patch(facecolor='none', edgecolor=SIM_EDGE, hatch=SIM_HATCH, linewidth=1, label='Simulation (panel C)'),
]
axD.legend(handles=legend_elements, loc='center left', frameon=False, fontsize=12)

from pathlib import Path

script_dir = Path(__file__).resolve().parent

output_dir = script_dir / "Output"
output_dir.mkdir(parents=True, exist_ok=True)
save_path = output_dir / "figure4 with error bar.jpg"
